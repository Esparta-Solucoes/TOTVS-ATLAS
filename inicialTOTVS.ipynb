import pandas as pd
import os

# Caminho base onde estão os arquivos
caminho_base = r"C:\Users\loren\Documents\FIAP\FIAP_enterprise_fase5\Challenge_TOTVS_2025_MassaDados_v1"

# Arquivo de saída do log (na mesma pasta)
arquivo_saida = os.path.join(caminho_base, "exploracao_output.txt")

# Lista dos arquivos a explorar
arquivos = [
    "clientes_desde.csv",
    "contratacoes_ultimos_12_meses.csv",
    "dados_clientes.csv",
    "historico.csv",
    "mrr.csv",
    "nps_relacional.csv",
    "nps_transacional_aquisicao.csv",
    "nps_transacional_implantacao.csv",
    "nps_transacional_onboarding.csv",
    "nps_transacional_produto.csv",
    "nps_transacional_suporte.csv",
    "telemetria_1.csv", "telemetria_2.csv", "telemetria_3.csv", "telemetria_4.csv",
    "telemetria_5.csv", "telemetria_6.csv", "telemetria_7.csv", "telemetria_8.csv",
    "telemetria_9.csv", "telemetria_10.csv", "telemetria_11.csv",
    "tickets.csv"
]

# Função para padronizar nulos como 'null'
def padronizar_nulos(df):
    return df.fillna('null')

# Função de exploração inicial
def explorar_csv(nome_arquivo, print_func=print):
    caminho = os.path.join(caminho_base, nome_arquivo)
    print_func("="*100)
    print_func(f"ARQUIVO: {nome_arquivo.upper()}")
    
    # Leitura com fallback de encoding
    try:
        df = pd.read_csv(caminho, sep=";", encoding="utf-8-sig")
    except UnicodeDecodeError:
        try:
            df = pd.read_csv(caminho, sep=";", encoding="latin1")
            print_func("Aviso: arquivo lido com encoding latin1")
        except Exception as e:
            print_func(f"Erro ao ler {nome_arquivo.upper()}: {e}")
            return
    except Exception as e:
        print_func(f"Erro ao ler {nome_arquivo.upper()}: {e}")
        return

    print_func(f"-> Linhas: {df.shape[0]}, Colunas: {df.shape[1]}")
    print_func("-"*100)
    print_func("INFO DO DATAFRAME:")
    print_func(df.info())
    print_func("-"*100)
    print_func("COLUNAS:")
    print_func(df.columns.tolist())
    print_func("-"*100)
    print_func("PRIMEIRAS LINHAS:")
    print_func(df.head())
    print_func("-"*100)
    print_func("ÚLTIMAS LINHAS:")
    print_func(df.tail())
    print_func("-"*100)

    # Amostra aleatória limitada
    n_sample = min(5, len(df))
    print_func(f"AMOSTRA ALEATÓRIA ({n_sample} LINHAS):")
    print_func(df.sample(n_sample, random_state=42))
    print_func("-"*100)

    print_func("VALORES NULOS POR COLUNA:")
    print_func(df.isnull().sum())
    print_func("-"*100)
    print_func("VALORES VAZIOS (STRINGS EM BRANCO):")
    print_func((df == '').sum())
    print_func("-"*100)
    print_func("DUPLICADOS:")
    print_func(df.duplicated().sum())
    print_func("-"*100)
    print_func("VALORES ÚNICOS POR COLUNA:")
    print_func(df.nunique())
    print_func("-"*100)
    print_func("CONSUMO DE MEMÓRIA (TOTAL EM BYTES):")
    print_func(df.memory_usage(deep=True).sum())
    print_func("-"*100)

    # Estatísticas descritivas numéricas
    if len(df.select_dtypes(include='number').columns) > 0:
        print_func("ESTATÍSTICAS DESCRITIVAS (NUMÉRICAS):")
        print_func(df.describe(include='number').transpose())
    else:
        print_func("ESTATÍSTICAS DESCRITIVAS (NUMÉRICAS): nenhuma coluna numérica encontrada.")
    print_func("-"*100)

    # Estatísticas descritivas categóricas
    if len(df.select_dtypes(include='object').columns) > 0:
        print_func("ESTATÍSTICAS DESCRITIVAS (CATEGÓRICAS):")
        print_func(df.describe(include='object').transpose())
    else:
        print_func("ESTATÍSTICAS DESCRITIVAS (CATEGÓRICAS): nenhuma coluna categórica encontrada.")
    print_func("-"*100)

    # Estatísticas de datas
    if len(df.select_dtypes(include='datetime').columns) > 0:
        print_func("ESTATÍSTICAS DESCRITIVAS (DATAS):")
        for col in df.select_dtypes(include='datetime').columns:
            print_func(f"   {col}: mínimo = {df[col].min()}, máximo = {df[col].max()}, intervalo = {df[col].max() - df[col].min()}")
    else:
        print_func("ESTATÍSTICAS DESCRITIVAS (DATAS): nenhuma coluna de data encontrada.")
    print_func("-"*100)

    # Padronização de nulos
    print_func("PADRONIZANDO VALORES NULOS PARA 'NULL'...")
    df_padronizado = padronizar_nulos(df.copy())
    print_func("EXEMPLO APÓS PADRONIZAÇÃO:")
    print_func(df_padronizado.head())
    print_func("VALORES NULOS APÓS PADRONIZAÇÃO:")
    print_func(df_padronizado.isnull().sum())
    print_func("="*100 + "\n")

# Executar exploração e salvar output em TXT
with open(arquivo_saida, "w", encoding="utf-8") as f:

    # Função para print duplo (console + txt)
    def print_duplo(*args, **kwargs):
        print(*args, **kwargs)          # console
        print(*args, **kwargs, file=f)  # arquivo txt

    for arq in arquivos:
        explorar_csv(arq, print_func=print_duplo)
